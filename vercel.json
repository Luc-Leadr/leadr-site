{
  "redirects": [
    {
      "source": "/developpement-commercial.html",
      "destination": "/methode.html",
      "permanent": true
    },
    {
      "source": "/validation-marche.html",
      "destination": "/methode.html",
      "permanent": true
    },
    {
      "source": "/offre-pme-pmi.html",
      "destination": "/implantation.html",
      "permanent": true
    },
    {
      "source": "/offre-eti-grands-comptes.html",
      "destination": "/implantation.html",
      "permanent": true
    },
    {
      "source": "/partenaires.html",
      "destination": "/leadr.html",
      "permanent": true
    },
    {
      "source": "/session-cadrage.html",
      "destination": "/premier-rendez-vous.html",
      "permanent": true
    },
    {
      "source": "/ressources.html",
      "destination": "/reperes.html",
      "permanent": true
    },
    {
      "source": "/delegation-commerciale",
      "destination": "/prospection-externalisee-suisse.html",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/mentions-legales.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "leadr-site.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(css|js|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}